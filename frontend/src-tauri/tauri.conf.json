{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HART",
  "version": "0.1.0",
  "identifier": "com.vig.hart",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HART",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#0d0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/hart-emulator"]
  }
}
