{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HART",
  "version": "0.0.1-alpha",
  "identifier": "com.vig.hart",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HART",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#0d0d10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "app", "dmg"],
    "publisher": "Vigintillionn",
    "copyright": "Copyright (C) 2025-2026 Vigintillionn",
    "category": "DeveloperTool",
    "shortDescription": "RISC-V assembly IDE and time-travel debugger",
    "longDescription": "HART is a desktop IDE and time-travel debugger for RISC-V (RV32IM) assembly. Write, assemble, and run programs, then step through them forwards and backwards while watching every register, CSR, and byte of memory change.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/hart-emulator"],
    "fileAssociations": [
      {
        "ext": ["s", "asm"],
        "name": "RISC-V Assembly",
        "description": "RISC-V assembly source file",
        "mimeType": "text/x-asm",
        "role": "Editor"
      }
    ]
  }
}
