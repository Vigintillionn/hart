{
  "name": "hart",
  "version": "0.0.1-alpha",
  "description": "Desktop IDE and time-travel debugger for RISC-V assembly.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build-sidecar": "bash ./build-sidecar.sh",
    "dev": "vite dev",
    "build": "pnpm run build-sidecar && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.55.1",
    "paneforge": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
